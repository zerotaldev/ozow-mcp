# Ozow One API credentials, from the Ozow Portal under "One API clients".
# Access to that section is granted by Ozow support or your account manager.
OZOW_CLIENT_ID=
OZOW_CLIENT_SECRET=
OZOW_SITE_CODE=XXX-XXX-XXX

# staging (default) or production.
# Leave this alone until the integration is finished and tested.
OZOW_ENV=staging

# Production ALSO requires this exact string. Without it the server refuses
# to start rather than quietly running against staging.
# OZOW_ALLOW_PRODUCTION=i-understand-this-moves-real-money

# Ceiling in rands on any single payment request. Raise deliberately.
OZOW_MAX_AMOUNT=1000

OZOW_SCOPE=payments
